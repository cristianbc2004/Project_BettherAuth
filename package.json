{
  "name": "project_bettherauth",
  "private": true,
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,mobile -c blue,green \"bun run api:start\" \"bun run mobile:dev-client -- --clear\"",
    "api:dev": "bun --watch apps/api/src/index.ts",
    "api:start": "bun apps/api/src/index.ts",
    "start": "bun --filter @repo/mobile start",
    "android": "bun --filter @repo/mobile android",
    "ios": "bun --filter @repo/mobile ios",
    "web": "bun --filter @repo/mobile web",
    "start:dev-client": "bun --filter @repo/mobile start",
    "mobile:start": "bun --filter @repo/mobile start",
    "mobile:dev-client": "bun --filter @repo/mobile start:dev-client",
    "mobile:android": "bun --filter @repo/mobile android",
    "mobile:ios": "bun --filter @repo/mobile ios",
    "mobile:web": "bun --filter @repo/mobile web",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck",
    "db:generate": "bun --filter @repo/database db:generate",
    "db:migrate": "bun --filter @repo/database db:migrate",
    "db:studio": "bun --filter @repo/database db:studio"
  },
  "devDependencies": {
    "@socketsecurity/bun-security-scanner": "^1.1.2",
    "concurrently": "^9.2.1",
    "portless": "^0.13.0",
    "turbo": "^2.9.12",
    "typescript": "~5.9.2"
  }
}
