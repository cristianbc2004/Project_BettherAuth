{
  "name": "project_bettherauth",
  "private": true,
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --kill-signal SIGINT --kill-timeout 3000 -n api,mobile -c blue,green \"bun run api:start\" \"bun run mobile:dev-client -- --clear\"",
    "api:dev": "bun --watch apps/api/src/index.ts",
    "api:start": "bun apps/api/src/index.ts",
    "start": "bun --cwd apps/mobile run start",
    "android": "bun --cwd apps/mobile run android",
    "ios": "bun --cwd apps/mobile run ios",
    "web": "bun --cwd apps/mobile run web",
    "start:dev-client": "bun --cwd apps/mobile --env-file=../../.env expo start --dev-client --host lan",
    "portless:stop": "portless proxy stop",
    "api:portless": "portless api -- bun run api:start",
    "mobile:start": "bun --cwd apps/mobile run start",
    "mobile:dev-client": "bun --cwd apps/mobile --env-file=../../.env expo start --dev-client --host lan",
    "mobile:android": "bun --cwd apps/mobile run android",
    "mobile:ios": "bun --cwd apps/mobile run ios",
    "mobile:web": "bun --cwd apps/mobile run web",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck",
    "db:generate": "bun --cwd packages/database run db:generate",
    "db:migrate": "bun --cwd packages/database run db:migrate",
    "db:studio": "bun --cwd packages/database run db:studio"
  },
  "devDependencies": {
    "@socketsecurity/bun-security-scanner": "^1.1.2",
    "concurrently": "^9.2.1",
    "portless": "^0.13.0",
    "turbo": "^2.9.12",
    "typescript": "~5.9.2"
  }
}
