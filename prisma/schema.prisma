generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String     @id @default(cuid())
  name             String
  email            String     @unique
  emailVerified    Boolean    @default(false)
  image            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  twoFactorEnabled Boolean    @default(false)
  role             String     @default("user")
  banned           Boolean    @default(false)
  banReason        String?
  banExpires       DateTime?
  totalBalanceCents Int       @default(0)
  accounts         Account[]
  sessions         Session[]
  targets          Target[]
  twoFactor        TwoFactor?
  bizumSentTransfers      BizumTransfer[] @relation("BizumTransferSender")
  bizumReceivedTransfers  BizumTransfer[] @relation("BizumTransferReceiver")
  bizumRequestedPayments  BizumRequest[]  @relation("BizumRequestRequester")
  bizumPendingPayments    BizumRequest[]  @relation("BizumRequestPayer")
  notificationsReceived   Notification[]  @relation("UserNotificationsReceived")
  notificationsSent       Notification[]  @relation("UserNotificationsSent")

  @@map("users")
}

model Session {
  id             String   @id @default(cuid())
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model TwoFactor {
  id          String  @id @default(cuid())
  userId      String  @unique
  secret      String
  backupCodes String
  verified    Boolean @default(false)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

model Target {
  id           String   @id @default(cuid())
  userId       String
  type         CardType
  numberTarget String   @unique
  cvc          String
  name         String
  block        Boolean  @default(false)
  balanceCents Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoingBizumTransfers BizumTransfer[] @relation("BizumTransferSenderCard")
  incomingBizumTransfers BizumTransfer[] @relation("BizumTransferReceiverCard")

  @@index([userId])
  @@map("targets")
}

model BizumTransfer {
  id              String   @id @default(cuid())

  senderUserId    String
  receiverUserId  String

  senderCardId    String?
  receiverCardId  String?
  senderUser      User     @relation("BizumTransferSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  receiverUser    User     @relation("BizumTransferReceiver", fields: [receiverUserId], references: [id], onDelete: Restrict)
  senderCard      Target?  @relation("BizumTransferSenderCard", fields: [senderCardId], references: [id], onDelete: SetNull)
  receiverCard    Target?  @relation("BizumTransferReceiverCard", fields: [receiverCardId], references: [id], onDelete: SetNull)

  amountCents     Int
  currency        String   @default("EUR")

  concept         String?

  referenceCode   String   @unique
  idempotencyKey  String?  @unique

  requestedAt     DateTime @default(now())
  completedAt     DateTime?
  failedAt        DateTime?
  cancelledAt     DateTime?

  failureReason   String?
  metadata        Json?
  request         BizumRequest?
  notifications   Notification[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([senderUserId])
  @@index([receiverUserId])
  @@index([senderCardId])
  @@index([receiverCardId])
}

model BizumRequest {
  id               String   @id @default(cuid())

  requesterUserId  String
  payerUserId      String
  requesterUser    User     @relation("BizumRequestRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  payerUser        User     @relation("BizumRequestPayer", fields: [payerUserId], references: [id], onDelete: Restrict)

  amountCents      Int
  currency         String   @default("EUR")

  concept          String?

  expiresAt        DateTime?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  cancelledAt      DateTime?

  transferId       String?
  transfer         BizumTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)
  notifications    Notification[]

  referenceCode    String   @unique

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([transferId])
  @@index([requesterUserId])
  @@index([payerUserId])
}

model Notification {
  id                String    @id @default(cuid())
  userDestinationId String
  userEmisorId      String?

  type              NotificationType
  status            NotificationStatus @default(UNREAD)

  title             String
  body              String?
  actionRoute       String?   // ejemplo: "/bizum/pay?requestId=..."
  actionPayload     Json?     // datos extra para navegación

  transferId        String?
  bizumRequestId    String?

  readAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  userDestination   User      @relation("UserNotificationsReceived", fields: [userDestinationId], references: [id], onDelete: Cascade)
  userEmisor        User?     @relation("UserNotificationsSent", fields: [userEmisorId], references: [id], onDelete: SetNull)
  transfer          BizumTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)
  bizumRequest      BizumRequest?  @relation(fields: [bizumRequestId], references: [id], onDelete: SetNull)

  @@index([userDestinationId, createdAt])
  @@index([userDestinationId, status, createdAt])
  @@index([transferId])
  @@index([bizumRequestId])
  @@map("notifications")
}

model Auditoria {
  id              String   @id @default(cuid())
  userId          String?
  userName        String?
  userRol         String?
  action          String
  table           String
  oldvaluePayload Json?
  newvaluePayload Json?
  timestamp       DateTime @default(now())
  ipAddress       String?
  userAgent       String?
  status          String
  errorMensaje    String?
  targetUserId    String?
  sessionId       String?
  endpoint        String?
  source          String?
}

enum CardType {
  VISA
  MASTERCARD
  CHASBACK
  ORO
}

enum NotificationType {
  TRANSFER
  BIZUM_REQUEST
  BIZUM_SENT
  BIZUM_RECEIVED
  ALERT
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

